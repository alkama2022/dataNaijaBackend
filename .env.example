# Database
DATABASE_URL="postgresql://user:password@localhost:5432/datanaija?schema=public"

# JWT secret - change this in production!
JWT_SECRET="dev-secret-change-me-in-production"

# App URL (for CORS or email links if added later)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for the Auto-Buy scheduler endpoint (/api/auto-buy/run).
# The platform cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# Generate a long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET="change-me-to-a-long-random-string"

# Shared key for the admin API (/api/admin/auto-buy).
ADMIN_API_KEY="change-me-to-a-long-random-string"

# Set to "1" to make every simulated data delivery fail. Useful for
# rehearsing the Auto-Buy retry policy.
# AUTO_BUY_SIMULATE_FAILURE="0"
